---
layout: base.njk
title: Blog
permalink: /blog/index.html
---
<h1>Blog</h1>
<p class="lead">Experiments, lessons and practical observations from technology and enterprise transformation work.</p>
{% for post in collections.posts %}
<article class="post-card">
  <div class="meta">{{ post.date.toLocaleDateString('en-IN', { year:'numeric', month:'long', day:'numeric' }) }}</div>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p>{{ post.data.summary }}</p>
  <a href="{{ post.url }}">Read article →</a>
</article>
{% endfor %}
